          <circle cx="25" cy="25" r={r} stroke={color} strokeWidth="3.5" fill="none"
            strokeDasharray={c}
            strokeDashoffset={c * (1 - consumedPct / 100)}
            strokeLinecap="round"
            style={{ transition: "stroke-dashoffset 0.5s ease, stroke 0.3s ease" }} />
