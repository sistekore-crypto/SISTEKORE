                    {tt.emoji} {tt.label}
                  </span>
                  <span style={{ fontSize: 8.5, color: C.g400, fontFamily: "monospace" }}>
                    {new Date(e.ts).toLocaleString("es-CO", { dateStyle: "short", timeStyle: "short" })}
