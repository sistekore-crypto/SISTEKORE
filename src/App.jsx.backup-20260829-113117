          <KpiTk icon={Clock} val={`${cumplSLA}%`} label="Cumplimiento SLA" sub="Últimos 7 días" iconColor="#3B82F6" fill="#DBEAFE" fillTo="#BFDBFE" onClick={() => setTab("vencidos")} tooltip="Ver SLA en riesgo" />
