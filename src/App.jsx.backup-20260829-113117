      <div>
        <div style={{ background: `linear-gradient(135deg, #FFFFFF 0%, #F5F3FF 100%)`, borderRadius: 12, padding: 14, marginBottom: 14, border: `1px solid rgba(124,58,237,0.18)`, display: "flex", gap: 12, alignItems: "center" }}>
