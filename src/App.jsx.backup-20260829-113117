      {/* TAB: ACTIVOS / VENCIDOS / CRÍTICOS / EN PROCESO — Tabla rediseñada */}
      {(tab === "activos" || tab === "vencidos" || tab === "criticos" || tab === "enproceso") && (
        <div>
          {/* Search bar premium */}
          <div style={{ display: "flex", gap: 8, marginBottom: 14, alignItems: "center", flexWrap: "wrap" }}>
